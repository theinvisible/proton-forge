/* ═══════════════════════════════════════════════════════════════════════════
   ProtonForge – Centralized Dark Theme Stylesheet
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Global Combo Popup ────────────────────────────────────────────────── */
QComboBox QAbstractItemView {
    background-color: #2a2a2a;
    border: 1px solid #555;
    color: #e0e0e0;
    selection-background-color: #76B900;
    selection-color: #fff;
    outline: 0;
}

/* ── DLSSSettingsWidget ────────────────────────────────────────────────── */
DLSSSettingsWidget {
    background-color: #1a1a1a;
}

DLSSSettingsWidget QGroupBox {
    background-color: #262626;
    border: 1px solid #4a4a4a;
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 14px;
    font-weight: bold;
}

DLSSSettingsWidget QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 8px;
    color: #e0e0e0;
}

DLSSSettingsWidget QComboBox {
    background-color: #1e1e1e;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 4px 8px;
    color: #e0e0e0;
    combobox-popup: 0;
}

DLSSSettingsWidget QComboBox:focus {
    border-color: #76B900;
}

DLSSSettingsWidget QComboBox QAbstractItemView {
    background-color: #1e1e1e;
    border: 1px solid #555;
    color: #e0e0e0;
    selection-background-color: #76B900;
}

DLSSSettingsWidget QSpinBox {
    background-color: #1e1e1e;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 4px 8px;
    color: #e0e0e0;
}

DLSSSettingsWidget QSpinBox:focus {
    border-color: #76B900;
}

DLSSSettingsWidget QCheckBox {
    color: #d0d0d0;
    spacing: 6px;
}

DLSSSettingsWidget QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 1px solid #555;
    background-color: #1e1e1e;
}

DLSSSettingsWidget QCheckBox::indicator:checked {
    background-color: #76B900;
    border-color: #76B900;
}

DLSSSettingsWidget QLabel {
    color: #d0d0d0;
}

/* ── Disabled controls ──────────────────────────────────────────────────────
   Every rule above sets an explicit `color`, and an explicit colour in a
   stylesheet overrides the palette's Disabled colour group outright — so
   without these counterparts a switched-off control is pixel-identical to a
   live one. The panel relies on that distinction: for a native Linux game most
   of it is disabled on purpose, because the variables behind those controls
   are read by Proton/DXVK/DXVK-NVAPI and a native binary loads none of them
   (see DLSSSettingsWidget::applyPlatformGating). */
DLSSSettingsWidget QGroupBox:disabled,
DLSSSettingsWidget QGroupBox::title:disabled,
DLSSSettingsWidget QCheckBox:disabled,
DLSSSettingsWidget QLabel:disabled {
    color: #6a6a6a;
}

DLSSSettingsWidget QGroupBox:disabled {
    border-color: #3a3a3a;
}

DLSSSettingsWidget QCheckBox::indicator:disabled {
    border-color: #3a3a3a;
    background-color: #1a1a1a;
}

/* A ticked box that cannot act still reads as "on" — keep the tick legible so
   the stored setting stays visible, but drain the accent colour out of it. */
DLSSSettingsWidget QCheckBox::indicator:checked:disabled {
    background-color: #3d4f24;
    border-color: #3d4f24;
}

DLSSSettingsWidget QComboBox:disabled,
DLSSSettingsWidget QSpinBox:disabled {
    color: #6a6a6a;
    background-color: #1a1a1a;
    border-color: #3a3a3a;
}

DLSSSettingsWidget QScrollArea {
    border: none;
    background: transparent;
}

/* ── Settings tabs ─────────────────────────────────────────────────────── */
DLSSSettingsWidget QTabWidget::pane {
    border: 1px solid #444444;
    background: #1e1e1e;
    border-radius: 4px;
}

DLSSSettingsWidget QTabBar::tab {
    background: #262626;
    color: #cccccc;
    padding: 8px 16px;
    border: 1px solid #444444;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

DLSSSettingsWidget QTabBar::tab:selected {
    background: #333333;
    color: #ffffff;
    border-bottom: 2px solid #76B900;
}

DLSSSettingsWidget QTabBar::tab:hover:!selected {
    background: #404040;
}

/* ── Thin Scrollbar (shared) ───────────────────────────────────────────── */
DLSSSettingsWidget QScrollBar:vertical,
GameListWidget QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

DLSSSettingsWidget QScrollBar::handle:vertical,
GameListWidget QScrollBar::handle:vertical {
    background: #555;
    border-radius: 4px;
    min-height: 30px;
}

DLSSSettingsWidget QScrollBar::handle:vertical:hover,
GameListWidget QScrollBar::handle:vertical:hover {
    background: #6a6a6a;
}

DLSSSettingsWidget QScrollBar::add-line:vertical,
DLSSSettingsWidget QScrollBar::sub-line:vertical,
GameListWidget QScrollBar::add-line:vertical,
GameListWidget QScrollBar::sub-line:vertical {
    height: 0;
}

DLSSSettingsWidget QScrollBar::add-page:vertical,
DLSSSettingsWidget QScrollBar::sub-page:vertical,
GameListWidget QScrollBar::add-page:vertical,
GameListWidget QScrollBar::sub-page:vertical {
    background: transparent;
}
