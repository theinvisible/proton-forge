# The AppImage build tools, pinned. The single list: packaging/appimage/Dockerfile
# bakes them into the build image, and .github/workflows/release.yml installs the
# same two in its own container. Add or move a version here and both follow.
#
# Not the "continuous" tag, even though it is what upstream's own instructions
# use: it moves, so a build that worked last week is not reproducible and a
# checksum cannot be pinned at all. These are the newest dated releases.
#
# Consume with:  . packaging/appimage/tools.env
#
# Both are AppImages and are extracted rather than executed, because running one
# needs FUSE and a container does not have it without extra privileges.

LINUXDEPLOY_URL=https://github.com/linuxdeploy/linuxdeploy/releases/download/1-alpha-20251107-1/linuxdeploy-x86_64.AppImage
LINUXDEPLOY_SHA256=c20cd71e3a4e3b80c3483cef793cda3f4e990aca14014d23c544ca3ce1270b4d

LINUXDEPLOY_PLUGIN_QT_URL=https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/1-alpha-20250213-1/linuxdeploy-plugin-qt-x86_64.AppImage
LINUXDEPLOY_PLUGIN_QT_SHA256=15106be885c1c48a021198e7e1e9a48ce9d02a86dd0a1848f00bdbf3c1c92724

# The runtime appimagetool prepends to the squashfs — the few hundred kilobytes
# that make the finished file executable. Recent appimagetool versions no longer
# embed it and fetch it mid-build instead, which is why it has to be here: a build
# runs with no network, and without this the last step dies on
# "Failed to download runtime: server returned status code 0".
# Handed over with LDAI_RUNTIME_FILE.
APPIMAGE_RUNTIME_URL=https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-x86_64
APPIMAGE_RUNTIME_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d

# Where the Dockerfile and the release workflow put the extracted trees.
# build-appimage.sh looks here before it considers downloading anything.
LINUXDEPLOY_PREFIX=/opt/linuxdeploy
