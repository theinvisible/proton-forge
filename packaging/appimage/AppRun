#!/bin/bash
#
# The AppImage entry point.
#
# linuxdeploy ships a perfectly good AppRun of its own; this one exists for one
# reason. An AppRun has to prepend the bundle to LD_LIBRARY_PATH and friends, and
# those values are right for ProtonForge and wrong for everything ProtonForge
# spawns — a game, Proton, kscreen-doctor, gsettings, tar. A game that inherits
# them loads the bundle's libstdc++ and libglib over its own, from a mount that
# is unmounted the moment ProtonForge exits while the game is still running.
#
# The application cannot recover those values on its own once they are gone, so
# they are saved here, before anything is changed: PROTONFORGE_HOST_<VAR> holds
# what the desktop had. src/utils/HostEnvironment.cpp puts them back for every
# child process, and its variable list is this one — the two files are a pair and
# a variable added to one belongs in the other.
#
# An unset variable is saved as empty, which HostEnvironment translates back into
# "remove it" rather than "set it to empty". That distinction matters for
# LD_LIBRARY_PATH in particular: empty means the current directory to the loader.

set -u

HERE="$(dirname "$(readlink -f "${0}")")"
export APPDIR="${APPDIR:-$HERE}"

# Save first, change second. In this order it does not matter whether the desktop
# had these set or not.
for var in \
    LD_LIBRARY_PATH \
    QT_PLUGIN_PATH \
    QT_QPA_PLATFORM_PLUGIN_PATH \
    XDG_DATA_DIRS \
    GSETTINGS_SCHEMA_DIR \
    GDK_PIXBUF_MODULE_FILE \
    PERLLIB \
    PYTHONHOME
do
    eval "export PROTONFORGE_HOST_${var}=\"\${${var}:-}\""
done

export PATH="$APPDIR/usr/bin:${PATH:-/usr/bin:/bin}"
export LD_LIBRARY_PATH="$APPDIR/usr/lib:${LD_LIBRARY_PATH:-}"
export QT_PLUGIN_PATH="$APPDIR/usr/plugins:${QT_PLUGIN_PATH:-}"
export QT_QPA_PLATFORM_PLUGIN_PATH="$APPDIR/usr/plugins/platforms:${QT_QPA_PLATFORM_PLUGIN_PATH:-}"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# A trailing colon in LD_LIBRARY_PATH means the current directory, so strip the
# one the expansions above leave behind when the host value was empty.
LD_LIBRARY_PATH="${LD_LIBRARY_PATH%:}"
QT_PLUGIN_PATH="${QT_PLUGIN_PATH%:}"
QT_QPA_PLATFORM_PLUGIN_PATH="${QT_QPA_PLATFORM_PLUGIN_PATH%:}"

exec "$APPDIR/usr/bin/ProtonForge" "$@"
